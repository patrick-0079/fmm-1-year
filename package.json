{
  "name": "fmm-anniversary-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "optimize:art": "node scripts/optimize-art.mjs",
    "art:festival": "node scripts/build-arcade-art.mjs && node --experimental-strip-types scripts/build-shoes.mjs",
    "art:meadow": "node scripts/build-meadow-art.mjs && node --experimental-strip-types scripts/build-garments.mjs",
    "art:night": "node scripts/build-night-meadow.mjs",
    "art:lanes": "node scripts/build-lanes.mjs",
    "art:cursors": "node scripts/build-cursors.mjs",
    "audio:bass": "node --experimental-strip-types scripts/build-bass-audio.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.156.0"
  }
}
